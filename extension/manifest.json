{
  "manifest_version": 3,
  "name": "C.P.S. — AI Coding Companion",
  "version": "1.0.0",
  "description": "AI-powered coding assistant for code generation, debugging, explanation, and security analysis",
  "author": "C.P.S. Team",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "contextMenus",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:8899/*",
    "http://127.0.0.1:8899/*"
  ],

  "optional_host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "C.P.S. — AI Coding Companion"
  },

  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },

  "sidebar_action": {
    "default_title": "C.P.S. — AI Coding Companion",
    "default_panel": "sidebar/sidebar.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "cps-extension@cps-ai.org",
      "strict_min_version": "109.0"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://hackerrank.com/*",
        "https://*.hackerrank.com/*",
        "https://codeforces.com/*",
        "https://*.codeforces.com/*",
        "https://codechef.com/*",
        "https://*.codechef.com/*",
        "https://geeksforgeeks.org/*",
        "https://*.geeksforgeeks.org/*",
        "https://github.com/*",
        "https://*.github.com/*",
        "https://gitlab.com/*",
        "https://*.gitlab.com/*",
        "https://stackoverflow.com/*",
        "https://*.stackoverflow.com/*"
      ],
      "js": ["shared/browser-api.js", "site_adapters/adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
