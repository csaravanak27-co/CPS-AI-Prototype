# ==============================================================================
# VULNQUEST AI - Environment Configuration Example
# Copy this file to .env to configure local inference. Hosted providers stay disabled unless explicitly selected.
# ==============================================================================

# 1. Groq API (Fast hosted inference with free tier limits)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=
VULNQUEST_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API (Free tier quota available in supported regions)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3. OpenRouter API (Access to free and open-source models)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Gemma 4 through Ollama (local inference; model download is separate)
OLLAMA_HOST=http://localhost:11434
VULNQUEST_GEMMA_MODEL=gemma4:e2b-it-q4_K_M
VULNQUEST_PROVIDER=ollama

# General Settings
VULNQUEST_DATA_DIR=vulnquest_data
VULNQUEST_MAX_FILE_BYTES=1000000
