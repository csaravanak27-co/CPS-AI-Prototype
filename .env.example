# ==============================================================================
# C.P.S. — Environment Configuration Example
# Copy this file to .env to configure local or hosted AI providers.
# ==============================================================================

# 1. Local AI Inference (Ollama)
# Download from https://ollama.com and run 'ollama pull gemma4:e2b-it-q4_K_M'
OLLAMA_HOST=http://localhost:11434
CPS_GEMMA_MODEL=gemma4:e2b-it-q4_K_M
CPS_PROVIDER=ollama

# 2. Groq API (High-speed hosted inference with free tier limits)
# Get an API key at: https://console.groq.com/keys
GROQ_API_KEY=
CPS_MODEL=llama-3.3-70b-versatile

# 3. Google Gemini API (Free tier available)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 4. OpenRouter API
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5. Core Settings
CPS_DATA_DIR=cps_data
CPS_MAX_FILE_BYTES=1000000
CPS_PORT=8899
CPS_HOST=127.0.0.1

# Desktop-managed backend (opt-in; only loopback hosts are accepted)
CPS_BACKEND_ENABLED=0
CPS_BACKEND_HOST=127.0.0.1
